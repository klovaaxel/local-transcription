#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Downloaded on-device models (never commit)
*.onnx
*.gguf
*.ggml
*.bin


# Mirror of .agents/skills for Claude Code discovery; regenerate with tool/sync_skills.ps1
/.claude/skills/

# Release signing - never commit. The keystore itself lives outside the repo.
/android/key.properties
*.jks
*.p12
*.keystore

# Packaged installers produced by tool/package/*
/dist/
